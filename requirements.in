pyqt6==6.9.1
zstandard==0.25.0

# urwid powers the CLI depot/DLC selection menus. `managers/cli_manager.py`
# imports `ui/text_menus.py` at module level, so this is NOT optional: dropping it
# breaks CLI mode with a bare ModuleNotFoundError at import time.
urwid==2.6.16

# wsproto is required by steam.client for Steam WebSocket protocol support
wsproto==1.2.0

