# ASSella runtime dependencies - LOCKED for reproducible builds.
#
# Regenerate with:
#   uv pip compile requirements.in -o requirements.txt --python-version 3.13
#
# Do not hand-edit: `requirements.txt` is generated and the header records the
# uv version used. Edit `requirements.in` and recompile instead.
#
# Git dependencies are pinned to exact commits so a build can never change
# underneath us ("worked yesterday, broken today, no code change").
git+https://github.com/solsticegamestudios/steam.git@1373e885f26bb636225443787f54d4082283e5f3

# NOTE: `steam` itself declares vdf via git+...@v4.0. uv rejects declaring the
# same package from a different URL, so we pin the upstream ref here (v4.0 is a
# moving tag) and let steam's own requirement resolve. `uv pip compile` records
# the resolved commit in the lock, which is what actually pins the build.
git+https://github.com/solsticegamestudios/vdf.git@v4.0

beautifulsoup4==4.12.3
cachetools==5.5.2
capstone==5.0.6
configobj==5.0.9
cryptography==46.0.3
curl-cffi==0.13.0
gevent==25.9.1
gevent-eventemitter==2.1
protobuf==5.29.5
