[Desktop Entry]
Type=Application
Name=ASSella
Comment=Steam Game & Depot Management Suite
# Named assella.desktop to match setDesktopFileName() in src/main.py.
Exec=/usr/bin/assella %U
Icon=assella
Terminal=false
Categories=Utility;Game;
# Must match QApplication::applicationName() in src/main.py, which is what the
# window manager matches against to pick the taskbar icon.
StartupWMClass=ASSella
MimeType=x-scheme-handler/accela;