# Maintainer: niwia <niwia@users.noreply.github.com>
# This file is a template. The release workflow substitutes @VERSION@ and
# @RELEASE_URL@, generates real checksums, and runs makepkg on the result.
#
# Kept in-tree (rather than generated by a heredoc in the workflow) so it can
# be reviewed, diffed, and linted like any other source file.

pkgname=assella
pkgver=@VERSION@
pkgrel=1
pkgdesc="Steam Game & Depot Management Suite"
arch=('x86_64')
url="https://github.com/niwia/ASSella"
license=('GPL3')

# Must match the runtime set install.sh provisions on Arch, otherwise
# `pacman -S assella` yields an AppImage that cannot launch. The 32-bit
# libraries are required by the bundled Steam/VDF client code.
depends=(
  'fuse2'
  'python'
  'xcb-util-cursor'
  'libnotify'
  'git'
  'p7zip'
  'lib32-glibc'
  'lib32-openssl'
  'lib32-curl'
  'curl'
)
optdepends=('tor: bundled Tor support for SteamCMD and manifest fetching')
provides=('assella')
conflicts=('assella-bin' 'assella-git')
# The AppImage is fetched from the release rather than carried in the repo.
source=("@RELEASE_URL@")
sha256sums=('@SHA256@')
options=(!strip)

package() {
  install -dm755 "$pkgdir/usr/lib/assella"
  install -dm755 "$pkgdir/usr/bin"
  install -dm755 "$pkgdir/usr/share/applications"
  install -dm755 "$pkgdir/usr/share/icons/hicolor/500x500/apps"
  install -dm755 "$pkgdir/usr/share/pixmaps"

  install -m755 "ASSella.AppImage" "$pkgdir/usr/lib/assella/ASSella.AppImage"

  # icon.png is 500x500; install it at its natural size so desktop environments
  # do not upscale a mismatched density.
  install -Dm644 "assella.png" "$pkgdir/usr/share/icons/hicolor/500x500/apps/assella.png"
  install -Dm644 "assella.png" "$pkgdir/usr/share/pixmaps/assella.png"
  # Legacy alias kept so existing ACCELA launchers keep resolving.
  ln -sf assella.png "$pkgdir/usr/share/icons/hicolor/500x500/apps/accela.png"
  ln -sf assella.png "$pkgdir/usr/share/pixmaps/accela.png"

  # Must be named assella.desktop: src/main.py calls
  # setDesktopFileName("assella.desktop"), so a mismatched name breaks
  # window/icon association under Wayland.
  install -Dm644 "assella.desktop" "$pkgdir/usr/share/applications/assella.desktop"
  ln -sf assella.desktop "$pkgdir/usr/share/applications/accela.desktop"

  printf '%s\n' '#!/bin/sh' 'exec /usr/lib/assella/ASSella.AppImage "$@"' > "$pkgdir/usr/bin/assella"
  chmod 755 "$pkgdir/usr/bin/assella"
}