# ── AppImage binaries (too large for git; use GitHub Releases) ──────────────
*.AppImage
*.AppImage.bak

# ── Personal config with API keys ───────────────────────────────────────────
# The real config lives at ~/.config/Tachibana Labs/ACCELA.conf
# Only config.example.conf (styling only, no keys) is tracked
ACCELA.conf

# ── Runtime / cache ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyc
.venv/
*.log
logs/

# ── Temp/working dirs ────────────────────────────────────────────────────────
backups/
depots/
manifests/
morrenus_manifests/
hubcap_manifests/
*.db

# ── Workshop keys (personal) ────────────────────────────────────────────────
workshop_keys.txt

# ── GIFs (large media) ──────────────────────────────────────────────────────
gifs/

# ── Local scratch space ─────────────────────────────────────────────────────
# scripts/ is intentionally TRACKED — the pre-release checker and the release
# verification harness are the gate against shipping a broken build, so they
# belong in history. Only throwaway experiments go in scratch/.
scratch/

# ── OS junk ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Local release verification scratch ──────────────────────────────────────
# Build outputs from scripts/verify_release.sh
verify-build/
squashfs-root/
